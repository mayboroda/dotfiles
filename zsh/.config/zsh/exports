# asdf is a tool version manager, more [here](https://asdf-vm.com/guide/introduction.html)
# TODO: refactor all sources to have dynamic ref "$(brew --prefix asdf)/libexec/asdf.sh"
source /opt/homebrew/opt/asdf/libexec/asdf.sh

# fzf integration to zsh
source <(fzf --zsh)

# To activate the autosuggestions
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# To activate the syntax highlighting
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Use nvim to read man pages
export MANPAGER='nvim +Man!'

